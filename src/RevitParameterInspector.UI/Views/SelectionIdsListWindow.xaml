<Window x:Class="RevitParameterInspector.UI.Views.SelectionIdsListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selection Ids List Extra"
        SizeToContent="WidthAndHeight"
        MinWidth="320" MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="10">

        <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
        </Border>

        <!-- Selection NOTHING: view id only, Copy View Id + Close. -->
        <StackPanel x:Name="NoSelectionButtons" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <Button Content="複製視圖ID" Padding="10,4" Margin="0,0,8,0" Click="OnCopyViewIdOnlyClick" />
            <Button Content="關閉" Padding="10,4" Click="OnCloseClick" />
        </StackPanel>

        <!-- Selection ELEMENT: view id + categorized selection ids, four buttons in one row. -->
        <StackPanel x:Name="SelectionButtons" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <Button Content="複製ID" Padding="10,4" Margin="0,0,8,0" Click="OnCopyIdsOnlyClick" />
            <Button Content="複製訊息" Padding="10,4" Margin="0,0,8,0" Click="OnCopyFullTextClick" />
            <Button Content="複製訊息(OST)" Padding="10,4" Margin="0,0,8,0" Click="OnCopyOstCategoryClick" />
            <Button Content="關閉" Padding="10,4" Click="OnCloseClick" />
        </StackPanel>

    </StackPanel>
</Window>
